# Copy this file to .env for local development, and set the same keys as
# environment variables on your hosting provider (Render, Railway, etc.) for
# production. Never commit the real .env file.

# ---- Required: core server ----
NODE_ENV=development
PORT=3000
# Any long random string — used to sign session cookies/tokens.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ---- Required: database ----
# MySQL-compatible connection string, e.g. from Aiven, Railway or PlanetScale.
# Format: mysql://user:password@host:port/database?ssl-mode=REQUIRED
DATABASE_URL=

# ---- Required: object storage (voice recordings, generated files) ----
# Works with any S3-compatible provider: Cloudflare R2 (recommended, free
# tier), AWS S3, Backblaze B2, MinIO, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: only set this if the bucket/CDN is public. Leave blank to use
# short-lived signed URLs instead (recommended for private student data).
S3_PUBLIC_BASE_URL=

# ---- Optional but recommended: AI features (Moualim chat tutor, pronunciation scoring) ----
# Uses Groq's free, OpenAI-compatible API by default — no credit card needed.
# Sign up at console.groq.com, create an API key, and set:
OPENAI_API_KEY=
# IMPORTANT: no trailing "/v1" here — the code appends "/v1/..." itself.
# Groq: https://api.groq.com/openai   |   OpenAI (paid): leave blank (defaults to api.openai.com)
OPENAI_BASE_URL=https://api.groq.com/openai
# Model names — these defaults match Groq's free models. If you switch to
# OpenAI instead, override with LLM_MODEL=gpt-4o-mini and
# TRANSCRIPTION_MODEL=whisper-1.
LLM_MODEL=llama-3.3-70b-versatile
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Max Moualim messages one student can send per day. Protects Groq's shared
# free-tier rate limit from being used up by a single very active user.
TEACHER_CHAT_DAILY_LIMIT=40
# Leave OPENAI_API_KEY blank and the app still runs fine — Moualim shows a
# friendly "unavailable" message instead of crashing, and pronunciation
# practice just can't transcribe audio yet.

# ---- Optional: mobile app build-time config ----
# Set this to your deployed backend URL before building with EAS, e.g.
# https://madrasti-ai.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# ---- Not currently used (legacy Manus-platform OAuth) ----
# The app already has working email/password login (see app/login.tsx).
# These are only needed if you build out third-party OAuth (Google, etc.)
# yourself later.
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
